<https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#catalogo> a dcat:Catalog ;
    dct:description "Datos abiertos, agregados por municipio, para estudiar si los topes de las ayudas al alquiler para jóvenes llegan a quien más las necesita, y para el estudio de la oferta de alquiler que pide el art. 135 del Plan Estatal de Vivienda 2026-2030. Se rehacen con un comando desde los datos de origen."@es ;
    dct:issued "2026-11-08"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dct:license <http://publications.europa.eu/resource/authority/licence/CC_BY_4_0> ;
    dct:modified "2026-11-08"^^xsd:date ;
    dct:publisher <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#equipo> ;
    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Autonomia/Comunidad-Madrid> ;
    dct:title "Datos del proyecto sobre el Bono Alquiler Joven en la Comunidad de Madrid"@es ;
    dcat:dataset <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#base-de-datos>,
        <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#indicadores-municipios-2024>,
        <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#reparto-simulado> ;
    dcat:themeTaxonomy <http://datos.gob.es/kos/sector-publico/sector> ;
    foaf:homepage <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid> .

<https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#base-de-datos> a dcat:Dataset ;
    dct:accessRights <http://publications.europa.eu/resource/authority/access-right/PUBLIC> ;
    dct:accrualPeriodicity <http://publications.europa.eu/resource/authority/frequency/ANNUAL> ;
    dct:description "Todo lo que usa el proyecto, por municipio de la Comunidad de Madrid, en un solo fichero SQLite: población, renta, paro, hogares de alquiler e índice de necesidad; cada convocatoria del Bono Alquiler Joven, de las Ayudas al alquiler para jóvenes y del Plan Estatal de Vivienda 2026-2030 con su tope en cada municipio; solicitudes por programa y año; alquiler del SERPAVI de 2011 a 2024; y el reparto simulado con cada regla. Con diccionario de cada columna. La crea scripts/base_datos.py. Las columnas que vienen del SERPAVI (Ministerio de Vivienda y Agenda Urbana) siguen su aviso legal: reutilización permitida citando la fuente."@es ;
    dct:issued "2026-11-08"^^xsd:date ;
    dct:language <http://publications.europa.eu/resource/authority/language/SPA> ;
    dct:modified "2026-11-08"^^xsd:date ;
    dct:publisher <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#equipo> ;
    dct:spatial <http://datos.gob.es/recurso/sector-publico/territorio/Autonomia/Comunidad-Madrid> ;
    dct:temporal [ a dct:PeriodOfTime ;
            dcat:endDate "2024-12-31"^^xsd:date ;
            dcat:startDate "2011-01-01"^^xsd:date ] ;
    dct:title "Bono Alquiler Joven y alquiler por municipio: base de datos del proyecto"@es ;
    dcat:contactPoint [ a vcard:Organization ;
            vcard:fn "Equipo del proyecto (DataMad 2026)"@es ;
            vcard:hasURL <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid/issues> ;
            vcard:organization-name "Equipo del proyecto (DataMad 2026)"@es ] ;
    dcat:distribution <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid#base-de-datos-sqlite> ;
    dcat:keyword "Bono Alquiler Joven"@es,
        "Comunidad de Madrid"@es,
        "Plan Estatal de Vivienda 2026-2030"@es,
        "SERPAVI"@es,
        "alquiler"@es,
        "jóvenes"@es,
        "municipios"@es,
        "vivienda"@es ;
    dcat:landingPage <https://github.com/alessandrorodriguez881/ayudas-alquiler-joven-madrid> ;
    dcat:theme <http://datos.gob.es/kos/sector-publico/sector/vivienda> .

